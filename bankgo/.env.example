# BankGo — Environment Variables Example
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to the repository

# Auth (simulated PKCE)
EXPO_PUBLIC_AUTH_ISSUER=https://auth.bankgo.mock
EXPO_PUBLIC_AUTH_CLIENT_ID=bankgo-mobile-client
EXPO_PUBLIC_AUTH_REDIRECT_URI=bankgo://auth/callback

# API (MSW mock)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
